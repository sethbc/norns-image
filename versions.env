# Pinned versions for the norns trixie image. Sourced by build.sh (which
# passes each one to rpi-image-gen as IGconf_norns_<lowercase name>) and by
# tests/helpers.bash. Every download is checksum-verified against these.

# norns (monome/norns), built from the release tag unchanged
NORNS_TAG=v2.9.4
NORNS_COMMIT=14bbeae8646c6717f6bb44c8cd60250bf94b6042
NORNS_VERSION_TXT=260102
NORNS_UPDATE_URL=https://github.com/monome/norns/releases/download/v2.9.4/norns260102.tgz
NORNS_UPDATE_SHA256=816f48441ec449dc8e6a6a554a59a5e85c2793254e40b7b9be8a2635b5c0af53

# maiden (monome/maiden)
MAIDEN_TAG=v1.1.6
MAIDEN_COMMIT=905413da55d74f6f9fa83bcdb91cdb40eee7701f

# libmonome (monome/libmonome)
LIBMONOME_TAG=v1.4.11
LIBMONOME_COMMIT=9055ea22fd824839be821c10f6e9b13e9d2aa3cd

# liblo 0.31 (github.com/radarsat1/liblo), private to norns in
# /opt/norns/liblo031: matron restates liblo 0.31's `typedef void *lo_message`,
# which conflicts with trixie's liblo 0.32. Tag 0.31 is annotated; this is
# the commit it points to.
LIBLO031_TAG=0.31
LIBLO031_COMMIT=840ed69b1d669a1ce587eb592746e3dff6985d76

# libgpiod v1 (git.kernel.org/pub/scm/libs/libgpiod/libgpiod.git)
LIBGPIOD1_TAG=v1.6.5
LIBGPIOD1_COMMIT=44e6985fa2afeca880607ec9238ece110164b774

# raspberrypi/linux rpi-6.18.y commit the vendored codec sources come from
CODEC_SRC_COMMIT=a4985478de14b3a83c8e04fed68377c1bdae735d

# dust audio (common samples), from the norns v2.7.1 release
DUST_AUDIO_COMMON_URL=https://github.com/monome/norns/releases/download/v2.7.1/dust-audio-common.tgz
DUST_AUDIO_COMMON_SHA256=b411ab07f9bd7bcb0f7452776368de791ab0a6df5ba3f8a84d903fb6c3502240

# raspberrypi/rpi-image-gen, vendored as the vendor/rpi-image-gen submodule
RPI_IMAGE_GEN_COMMIT=ff5fb451fac47debf441a5a2b39aa3ade7988bd6
